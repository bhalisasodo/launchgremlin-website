# LaunchGremlin Frontend Environment Variables (Vite)
# Injected into the static client bundle at build time (npm run build)

# Backend API & MCP Server URL (without trailing slash)
# Production: https://backend.launchgremlin.com
# Local dev: http://localhost:5000 (or leave unset to use Vite dev proxy)
VITE_API_URL=https://backend.launchgremlin.com
